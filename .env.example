# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID or Channel Username (e.g. -100123456789 or @your_channel_name)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# (Optional) Playwright Authentication State JSON string
# If your TradingView chart requires login, copy the contents of auth_state.json and place it here as a single-line string.
# PLAYWRIGHT_AUTH_STATE={"cookies": [...], "origins": [...]}

# (Optional) Screenshot Viewport Dimensions
# You can customize these dimensions (width x height) to change the chart's size/aspect ratio.
# - Use 1920x1080 for standard full-screen desktop view.
# - Use 480x800 for a clean, vertical mobile-style view (hides sidebars).
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080

# (Optional) Target Selector for Screenshot
# - Use '.layout__area--center' for a close-up of the chart and price scales only.
# - Use 'viewport' (default) to capture the entire browser screen including toolbars/menus.
# SCREENSHOT_SELECTOR=viewport

# (Optional) Browser Zoom/Scale Factor (Option 2)
# - Set to 1.25 for 125% zoom, 1.5 for 150% zoom, etc. to make everything larger/closer.
# BROWSER_ZOOM_FACTOR=1.0

# (Optional) Horizontal Pan Offset (Drag Left)
# - Set to 150 (pixels) to drag the chart to the left, revealing the right-side price scale and margin.
# - Set to 0 to disable dragging.
# CHART_DRAG_LEFT_PX=0

# (Optional) Chart Settings
# - SYMBOL: The trading symbol on TradingView (e.g. NSE:NIFTY, NSE:BANKNIFTY)
# - INTERVAL: Timeframe interval (e.g. 15 for 15 minutes, 60 for 1 hour, D for daily)
# - CHART_OUTPUT_FILENAME: The local filename to save the screenshot in the project folder
# SYMBOL=NSE:NIFTY
# INTERVAL=60
# CHART_OUTPUT_FILENAME=nifty_1h_chart.png
